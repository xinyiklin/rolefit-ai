{
  "manifest_version": 3,
  "name": "RoleFit",
  "version": "1.5.2",
  "description": "Prepare job postings in RoleFit for AI-powered resume tailoring and review.",
  "minimum_chrome_version": "123",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RoleFit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "commands": {
    "import-job": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Import this job posting into RoleFit"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "role-fit-ai@localhost",
      "strict_min_version": "128.0"
    }
  }
}
