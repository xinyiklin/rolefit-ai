{
  // Type-check-only config for the Node server + the shared modules it imports.
  // The server runs under Node's native TypeScript type stripping (Node 24.18+),
  // so this config never emits (noEmit) — it only enforces types. "erasable
  // syntax only": no enums, namespaces, or parameter properties, matching what
  // Node can strip. `allowImportingTsExtensions` lets the Node-executed files
  // keep their explicit `.ts` import specifiers (Node type stripping does no
  // extension resolution). NodeNext plus rewrite checking keeps the compiler
  // aligned with the runtime's native ESM rules.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "src/lib/coverLetterEvidence.ts",
    "src/lib/coverLetterPreflight.ts",
    "src/lib/jobIdentity.ts",
    "src/resume/sections.ts"
  ]
}
