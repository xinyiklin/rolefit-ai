{
  "name": "typeset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-fonts": "node scripts/sync-fonts.mjs",
    "predev": "npm run sync-fonts",
    "dev": "vite",
    "prebuild": "npm run sync-fonts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "eval:autosave": "node --experimental-strip-types src/__evals__/resume-autosave.mjs && node --experimental-strip-types src/__evals__/document-save-baseline.mjs",
    "check": "npm run build && npm run eval:autosave"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@typeset/editor": "*",
    "@typeset/engine": "*",
    "lucide-react": "1.27.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
